@page
@model IndexModel
@{
    ViewData["Title"] = "Machine Status";
}
<p id="message" class="message" hidden="@(Model.Message is null)">@Model.Message</p>
<table data-refresh="@Model.RefreshIntervalMs">
    <thead>
        <tr>
            <th>Machine</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (MachineConfig machine in Model.Machines)
        {
            <tr data-name="@machine.Name">
                <td>@machine.Name</td>
                <td><span class="badge checking">Checking</span></td>
                <td>
                    <div class="actions">
                        @if (!string.IsNullOrWhiteSpace(machine.Mac))
                        {
                            <form method="post" class="slot-wake">
                                <input type="hidden" name="name" value="@machine.Name" />
                                <button type="submit" class="wake" asp-page-handler="Wake">Wake</button>
                            </form>
                        }
                        @if (!string.IsNullOrWhiteSpace(machine.SemaphoreHost))
                        {
                            @if (machine.CanSleep)
                            {
                                <form method="post" class="slot-sleep">
                                    <input type="hidden" name="name" value="@machine.Name" />
                                    <button type="submit" class="power" asp-page-handler="Sleep" data-confirm="Put @machine.Name to sleep?">Sleep</button>
                                </form>
                            }
                            <form method="post" class="slot-power">
                                <input type="hidden" name="name" value="@machine.Name" />
                                <button type="submit" class="power danger" asp-page-handler="PowerOff" data-confirm="Power off @machine.Name?">Power</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>